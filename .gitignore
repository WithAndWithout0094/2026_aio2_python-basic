# ===== 가상환경 =====
# pip install로 언제든 재생성 가능 + 용량이 매우 큼 → 절대 올리면 안 됨
.venv/
venv/
env/

# ===== 파이썬 캐시/컴파일 파일 =====
# 파이썬이 실행할 때 자동으로 생성 (소스코드 아님, 사람이 직접 작성 X)
__pycache__/
*.pyc
*.pyo

# ===== 주피터 노트북 =====
# .ipynb 실행 시 자동 생성되는 임시 체크포인트 (버전관리 대상 아님)
.ipynb_checkpoints/

# ===== 민감 정보 =====
# API 키, 비밀번호 등이 들어갈 수 있는 파일 (지금은 없지만 앞으로 생길 수 있어 미리 방어)
.env
*.env
secrets.json

# ===== 에디터/IDE 설정 =====
# 개인 로컬 환경 설정 (팀원과 공유할 필요 없는 개인 취향 세팅)
.vscode/
study.code-workspace

# ===== OS가 자동으로 만드는 파일 =====
.DS_Store
Thumbs.db

# ===== 개인 제외 파일 =====
1_입출력(수업).ipynb
